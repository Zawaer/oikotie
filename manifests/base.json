{
  "manifest_version": 3,
  "name": "Oikotie",
  "version": "3.0",
  "description": "Automate the repetitive login process for Kampus, Nova and Studeo.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://kirjautuminen.sanomapro.fi/*",
    "https://mpass-proxy.csc.fi/*",
    "https://sanomapro.fi/*",
    "https://www.sanomapro.fi/*",
    "https://nova.otava.fi/*",
    "https://app.studeo.fi/*",
    "https://studeo.fi/*",
    "https://www.studeo.fi/*"
  ],
  "action": {
    "default_popup": "ui/popup.html",
    "default_title": "Oikotie",
    "default_icon": {
      "16": "ui/icons/icon16.png",
      "32": "ui/icons/icon32.png",
      "48": "ui/icons/icon48.png",
      "64": "ui/icons/icon64.png"
    }
  },
  "icons": {
    "16": "ui/icons/icon16.png",
    "32": "ui/icons/icon32.png",
    "48": "ui/icons/icon48.png",
    "64": "ui/icons/icon64.png",
    "96": "ui/icons/icon96.png",
    "128": "ui/icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "ui/setup.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://kirjautuminen.sanomapro.fi/*"
      ],
      "js": [
        "scripts/services.js",
        "ui/i18n.js",
        "scripts/content-common.js",
        "scripts/kampus-login-content.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://sanomapro.fi/*",
        "https://www.sanomapro.fi/*"
      ],
      "js": [
        "scripts/services.js",
        "ui/i18n.js",
        "scripts/content-common.js",
        "scripts/sanomapro-content.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://nova.otava.fi/*"
      ],
      "js": [
        "scripts/services.js",
        "ui/i18n.js",
        "scripts/content-common.js",
        "scripts/nova-content.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://studeo.fi/*",
        "https://www.studeo.fi/*",
        "https://app.studeo.fi/*"
      ],
      "js": [
        "scripts/services.js",
        "ui/i18n.js",
        "scripts/content-common.js",
        "scripts/studeo-content.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://mpass-proxy.csc.fi/*"
      ],
      "js": [
        "scripts/services.js",
        "ui/i18n.js",
        "scripts/content-common.js",
        "scripts/mpass-content.js"
      ],
      "run_at": "document_end"
    }
  ]
}
